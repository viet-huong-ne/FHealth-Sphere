@model IEnumerable<Contract.Repositories.Entity.BloodPressureClassification>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SystolicMin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SystolicMax)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DiastolicMin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DiastolicMax)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SystolicMin)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SystolicMax)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DiastolicMin)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DiastolicMax)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
